{
  "name": "brand-artisan",
  "version": "0.1.0-rc.6",
  "type": "module",
  "description": "Turn JSX into brand images (Open Graph, social posts, banners). next/og's engine outside Next: no browser, no Figma, no server.",
  "keywords": [
    "og-image",
    "open-graph",
    "social-images",
    "satori",
    "resvg",
    "jsx",
    "react",
    "branding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roslove44/brand-artisan.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./brandkit": "./src/brandkit.ts",
    "./colors": "./src/colors.ts"
  },
  "bin": {
    "brand-artisan": "bin/brand-artisan.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "build": "tsx src/build.ts",
    "pdf": "node bin/brand-artisan.js pdf",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:consumer": "tsx test/consumer-check.ts",
    "test:generator": "tsx test/generator-check.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/fontkit": "^2.0.9",
    "@types/pngjs": "^6.0.5",
    "fontkit": "^2.0.4",
    "jpeg-js": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "satori": "^0.12.1",
    "tsx": "^4.19.2"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
