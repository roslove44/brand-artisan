{
  "name": "brand-artisan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fabrique des images (couvertures, OG, bannières) via Satori + resvg : le moteur next/og sorti de Next.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roslove44/brand-artisan.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./brandkit": "./src/brandkit.ts",
    "./colors": "./src/colors.ts"
  },
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "build": "tsx src/build.ts",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:consumer": "tsx test/consumer-check.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "^2.0.4",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "satori": "^0.12.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
